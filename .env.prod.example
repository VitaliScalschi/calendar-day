# Copiază în .env pe server: cp .env.prod.example .env
# Apoi editează parolele și JWT_SECRET_KEY.

POSTGRES_DB=calendar_day
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

JWT_ISSUER=CalendarDay.Api
JWT_AUDIENCE=CalendarDay.Client
# Obligatoriu: minim 32 caractere (altfel login returnează 500).
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=https://calendar.cec.md,http://calendar.cec.md

# SMTP (parola NU în React — doar în backend / .env)
SMTP_HOST=mail.cec.md
SMTP_PORT=465
SMTP_USERNAME=emailul_meu@cec.md
SMTP_PASSWORD=PAROLA_SAU_APP_PASSWORD
SMTP_FROM_EMAIL=emailul_meu@cec.md
SMTP_FROM_NAME=Calendar CEC
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false

# Link reset parolă în email
PASSWORD_RESET_FRONTEND_URL=https://calendar.cec.md
