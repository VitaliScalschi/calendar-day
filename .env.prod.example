# Copiază în .env pe server: cp .env.prod.example .env
# Apoi editează parolele și JWT_SECRET_KEY.

POSTGRES_DB=calendar_day
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

JWT_ISSUER=CalendarDay.Api
JWT_AUDIENCE=CalendarDay.Client
# Obligatoriu: minim 32 caractere (altfel login returnează 500).
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGINS=https://calendar.cec.md,http://calendar.cec.md
