{
  "SiaAdminSoap": {
    "Endpoint": "https://siaadmin.cec.md/WebServices/SingleAccessPointService.svc",
    "TimeoutSeconds": 30,
    "ApiToken": "",
    "ApiTokenHeaderName": "X-Api-Token",
    "AdminRoleKeywords": [ "Administrator" ],
    "EditorRoleKeywords": [ "Operator", "Editor" ],
    "SiaPreferLeastPrivilegedMappedRoleWhenMultiple": false,
    "SessionCookieName": "SAISE.Token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
