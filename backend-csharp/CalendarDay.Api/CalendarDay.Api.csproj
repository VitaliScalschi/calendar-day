    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>54e51beb-cb7c-4e57-8754-9bc60899cf0f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SmtpProbe\**" />
