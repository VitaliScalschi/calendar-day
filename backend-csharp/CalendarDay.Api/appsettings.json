{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=calendar_day;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "CalendarDay.Api",
    "Audience": "CalendarDay.Client",
    "SecretKey": "replace-this-with-very-long-secret-at-least-32-chars",
    "ExpirationMinutes": 120
  },
  "SiaAdminSoap": {
    "Endpoint": "https://siaadmin.cec.md/WebServices/SingleAccessPointService.svc",
    "TimeoutSeconds": 30,
    "ApiToken": "",
    "ApiTokenHeaderName": "X-Api-Token",
    "AdminRoleKeywords": [ "Administrator" ],
    "EditorRoleKeywords": [ "Operator", "Editor" ],
    "SiaPreferLeastPrivilegedMappedRoleWhenMultiple": false,
    "SessionCookieName": "SAISE.Token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
